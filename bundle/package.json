{
  "name": "dsh-websearch-tavily-keys-select",
  "version": "3.0.0",
  "type": "module",
  "main": "./host/index-v5.mjs",
  "icon": "./icon.svg",
  "description": "DSH 的 Web 搜索链路：源 → key → 额度 三级模型。一个源可放多把 key（每把独立额度、可单独启停/删除），源有自己的计费方式；key 额度用完自动换同源下一把，整源不可用再换下一个源。内置腾讯元宝搜索（SearchPro，额度闸门 + Freshness/Site 意图解析）、Tavily（credits 记账 + 查额度）、DeepSeek 搜索 API。",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./host/index-v5.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "host/*.mjs",
    "cordis.patch.yml",
    "icon.svg",
    "assets/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "dsh-search-chain": "^3.0.0",
    "dsh-search-deepseek": "^1.1.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "dsh-plugin",
    "plugin",
    "web-search",
    "search",
    "tavily",
    "yuanbao",
    "tencent-cloud"
  ],
  "license": "MIT",
  "author": {
    "name": "apherchin"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apherchin/dsh-websearch-tavily-keys-select.git",
    "directory": "bundle"
  },
  "bugs": {
    "url": "https://github.com/apherchin/dsh-websearch-tavily-keys-select/issues"
  },
  "homepage": "https://github.com/apherchin/dsh-websearch-tavily-keys-select#readme",
  "engines": {
    "node": ">=20"
  }
}
